# Salin ke .env lalu isi. Jangan commit file .env.
# Semua nilai di sini setara dengan kunci TOML pada README.

# --- Akun (wajib) -----------------------------------------------------------
ITLG_LOGIN_ID=12345678
ITLG_PASSCODE=123456

# --- Login OTP (pilih salah satu jalur login) -------------------------------
ITLG_EMAIL=you@gmail.com
# App Password Gmail 16 karakter, bukan password akun. Boleh pakai spasi.
ITLG_IMAP_PASSWORD=abcd efgh ijkl mnop

# --- Login selfie (alternatif) ---------------------------------------------
# ITLG_FACE_PHOTO=/data/selfie.jpg

# --- Telegram (opsional) ----------------------------------------------------
ITLG_TELEGRAM_TOKEN=
ITLG_TELEGRAM_CHAT_ID=

# --- Runtime ----------------------------------------------------------------
ITLG_DATA_DIR=/data
ITLG_TIMEZONE=Asia/Jakarta
ITLG_LOG_LEVEL=INFO
ITLG_DRY_RUN=false
# ITLG_JITTER_MIN=45
# ITLG_JITTER_MAX=180
